{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ElasticBeanstalkDeploy",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:DescribeApplications",
        "elasticbeanstalk:DescribeApplicationVersions",
        "elasticbeanstalk:DescribeEnvironments",
        "elasticbeanstalk:DescribeEnvironmentHealth",
        "elasticbeanstalk:DescribeEvents",
        "elasticbeanstalk:CreateApplicationVersion",
        "elasticbeanstalk:UpdateEnvironment"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ArtefactosDeDeployEnS3",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::elasticbeanstalk-us-east-1-751835847253",
        "arn:aws:s3:::elasticbeanstalk-us-east-1-751835847253/*"
      ]
    },
    {
      "Sid": "FrontendEstaticoEnS3",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::odontocloud-frontend-2026",
        "arn:aws:s3:::odontocloud-frontend-2026/*"
      ]
    },
    {
      "Sid": "InvalidarCacheDeCloudFront",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListDistributions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NuncaTocarEvidenciaClinica",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::odontocloud-clinical-evidence-751835847253",
        "arn:aws:s3:::odontocloud-clinical-evidence-751835847253/*"
      ]
    },
    {
      "Sid": "NuncaTocarIdentidadNiBaseDeDatos",
      "Effect": "Deny",
      "Action": ["iam:*", "rds:*", "kms:ScheduleKeyDeletion", "ec2:TerminateInstances"],
      "Resource": "*"
    }
  ]
}
